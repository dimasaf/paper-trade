# Optional local overrides. Docker Compose supplies safe local defaults.
PAPER_TRADE_DATABASE_URL=postgresql+asyncpg://paper_trade:paper_trade@127.0.0.1:5432/paper_trade
PAPER_TRADE_REDIS_URL=redis://127.0.0.1:6379/0
PAPER_TRADE_WEB_ORIGIN=http://127.0.0.1:3000
PAPER_TRADE_WORKER_HEARTBEAT_KEY=paper-trade:worker:heartbeat
PAPER_TRADE_WORKER_HEARTBEAT_MAX_AGE_SECONDS=15
PAPER_TRADE_LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
